# OpenAI
LLM__OPENAI_API_KEY=sk-...
LLM__DEFAULT_MODEL=gpt-4.1-mini
LLM__REQUEST_TIMEOUT=30.0

# Redis (в Docker переопределяется через compose.yaml: redis://redis:6379/0)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# App
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000"]

RATE_LIMIT_PER_MIN=30

# Chat storage
CHAT_REPOSITORY=json
CHAT_STORAGE_DIR=./var/chats

# Postgres (используется при CHAT_REPOSITORY=postgres)
DATABASE_URL=postgresql+asyncpg://app:secret@localhost:5433/rag_legal

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me-qdrant
QDRANT_COLLECTION=documents
EMBEDDING_DIM=1536

# RAG block 5.3
RAG_COLLECTION=rag_block_03
RAG_BAREMETAL_COLLECTION=rag_block_03_baremetal
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SIMILARITY_TOP_K=3
RAG_SCORE_THRESHOLD=0.3

