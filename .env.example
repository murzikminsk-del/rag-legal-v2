# ─── Обязательные ────────────────────────────────────────────────

# Ключ OpenAI: чат-модель и эмбеддинги
LLM__OPENAI_API_KEY=sk-...

# Токен Telegram-бота от @BotFather
BOT_TOKEN=your-telegram-bot-token

# Общий секрет для запросов между сервисом и ботом
INTERNAL_TOKEN=change-me-internal

# Токен доступа к admin API
ADMIN_TOKEN=change-me-admin

# Ключ доступа к Qdrant (задаётся самим пользователем, любой строкой)
QDRANT_API_KEY=change-me-qdrant

# ─── Модель ──────────────────────────────────────────────────────

LLM__DEFAULT_MODEL=gpt-4.1-mini
LLM__REQUEST_TIMEOUT=30.0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ─── Бот ─────────────────────────────────────────────────────────

# Telegram ID администраторов (команды /stats, /users, /broadcast)
BOT_ADMIN_IDS=[123456789]

# ─── Хранилища ───────────────────────────────────────────────────
# В Docker адреса Redis, Postgres и Qdrant переопределяются в compose.yaml.
# Значения ниже нужны для запуска без Docker.

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://app:secret@localhost:5433/rag_legal
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# История чатов: postgres (переживает перезапуск) или json (файлы в CHAT_STORAGE_DIR)
CHAT_REPOSITORY=postgres
CHAT_STORAGE_DIR=./var/chats

# ─── Поиск по базе знаний ────────────────────────────────────────

CHUNK_SIZE=1024
CHUNK_OVERLAP=256
SIMILARITY_TOP_K=10
RAG_SCORE_THRESHOLD=0.3

# ─── Сервис ──────────────────────────────────────────────────────

LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MIN=30

# ─── Необязательные ──────────────────────────────────────────────

# Реранкер Cohere: включается, если ключ задан
# COHERE_API_KEY=

# Модерация входящих сообщений через OpenAI (по умолчанию включена)
# USE_OPENAI_MODERATION=true

# Память агента: sqlite | postgres | memory (в Docker задаётся postgres)
# AGENT_CHECKPOINTER=sqlite

# Прокси для запросов к OpenAI и Cohere, если нужен
# HTTPS_PROXY=socks5://127.0.0.1:10808

# Ключ для учебных скриптов ранних блоков (scripts/benchmark.py)
# OPENAI_API_KEY=sk-...