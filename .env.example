# OpenAI
LLM__OPENAI_API_KEY=sk-...
LLM__DEFAULT_MODEL=gpt-4.1-mini
LLM__REQUEST_TIMEOUT=30.0

# Redis (в Docker переопределяется через compose.yaml: redis://redis:6379/0)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# App
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000"]

RATE_LIMIT_PER_MIN=30

# Chat storage
CHAT_REPOSITORY=json
CHAT_STORAGE_DIR=./var/chats

# Postgres (используется при CHAT_REPOSITORY=postgres)
DATABASE_URL=postgresql+asyncpg://app:secret@localhost:5433/rag_legal